{
  "name": "redforge-desktop",
  "productName": "RedForge",
  "version": "2.0.2",
  "description": "RedForge — the local AI engineering platform, as a native desktop app.",
  "author": "RedForge <hello@redforge.site>",
  "license": "SEE LICENSE IN ../LICENSE",
  "main": "electron/main.js",
  "homepage": "https://redforge.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/BRGOVIND/REDFORGE.git"
  },
  "//icons": [
    "Icon strategy — read before changing any `icon` value in `build`.",
    "build/icon.png (512x512) is the canonical cross-platform source; electron-builder",
    "derives .icns for macOS and the PNG set for Linux from it. Windows needs a real",
    ".ico, so win/nsis point at installers/windows/*.ico.",
    "PLATFORM-SHARED keys (fileAssociations[].icon, protocols) must NEVER reference a",
    "platform-specific file: electron-builder rewrites the extension per platform",
    "(builder-util getPlatformIconFileName: value.replace('.ico', '.icns') on macOS), so",
    "'../installers/windows/desktop.ico' became '../installers/windows/desktop.icns' and",
    "broke the macOS build. Leave fileAssociations without an icon so it inherits the",
    "app icon, or place BOTH .ico and .icns under build/ with the same basename."
  ],
  "scripts": {
    "start": "electron .",
    "stage-backend": "python scripts/stage-backend.py",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.2.1"
  },
  "build": {
    "appId": "site.redforge.desktop",
    "productName": "RedForge",
    "copyright": "Copyright © RedForge",
    "directories": {
      "output": "release-build",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "BRGOVIND",
        "repo": "REDFORGE"
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "fileAssociations": [
      {
        "ext": "redforge",
        "name": "RedForge Project",
        "description": "RedForge project file",
        "role": "Editor"
      }
    ],
    "protocols": [
      {
        "name": "RedForge",
        "schemes": ["redforge"]
      }
    ],
    "win": {
      "icon": "../installers/windows/desktop.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "artifactName": "RedForge-v${version}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RedForge",
      "uninstallDisplayName": "RedForge ${version}",
      "installerIcon": "../installers/windows/installer.ico",
      "uninstallerIcon": "../installers/windows/installer.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "RedForge-v${version}-Setup.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "artifactName": "RedForge-v${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "RedForge ${version}",
      "artifactName": "RedForge-v${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "RedForge <hello@redforge.site>",
      "vendor": "RedForge",
      "synopsis": "Local AI engineering platform",
      "description": "Build, evaluate and manage local AI models — training, benchmarking, security evaluation and reporting, all on your own hardware.",
      "desktop": {
        "Name": "RedForge",
        "Comment": "Local AI engineering platform",
        "Categories": "Development;Science;"
      },
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "artifactName": "RedForge-v${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "RedForge-v${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libsecret-1-0"],
      "artifactName": "RedForge-v${version}-${arch}.${ext}"
    }
  }
}
