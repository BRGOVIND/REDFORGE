<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the signed/notarized macOS build.

  RedForge ships a PyInstaller-frozen backend that the app spawns as a child
  process. Under the hardened runtime that requires the JIT / unsigned-memory /
  library-validation exceptions below; without them the backend is killed at
  launch with "code signature invalid" and the app never becomes healthy.

  The network entitlements cover the loopback HTTP the UI uses to talk to the
  backend, plus model downloads from Hugging Face / Ollama.
-->
<plist version="1.0">
  <dict>
    <!-- Electron/V8 and the frozen Python runtime need writable+executable pages. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- The bundled backend's .so/.dylib files are not individually signed by us. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Loopback to the local backend + outbound model downloads. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- User-chosen workspace / dataset / model directories. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
